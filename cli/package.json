{
  "name": "@gentoro/mcpagent-cli",
  "version": "0.1.0",
  "description": "CLI for Gentoro MCP Agent - Connect APIs to AI models via Model Context Protocol",
  "type": "module",
  "bin": {
    "mcpagent": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "package": "npm run build && npm pack"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "openai",
    "gemini",
    "anthropic",
    "cli"
  ],
  "author": "Gentoro",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^9.2.23",
    "yaml": "^2.4.5",
    "ora": "^8.0.1",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "execa": "^8.0.1",
    "find-up": "^7.0.0",
    "fs-extra": "^11.2.0",
    "log-symbols": "^6.0.0",
    "strip-ansi": "^7.1.0",
    "boxen": "^7.1.1",
    "node-pty": "^1.0.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2"
  }
}

